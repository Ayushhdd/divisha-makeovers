{
  "name": "makeup-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:site": "next dev",
    "dev:all": "node scripts/dev-local.mjs",
    "build": "npm run build:portal && npm run build:site",
    "build:site": "next build",
    "start": "next start",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend start",
    "seed:backend": "npm --prefix backend run seed",
    "dev:portal": "npm --prefix portal-frontend run dev",
    "build:portal": "npm --prefix portal-frontend run build",
    "install:backend": "npm --prefix backend install",
    "install:portal": "npm --prefix portal-frontend install"
  },
  "dependencies": {
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
