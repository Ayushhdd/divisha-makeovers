PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/divisha-makeovers
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_REMEMBER_EXPIRE=30d
CLIENT_URL=http://localhost:3000,http://localhost:5173
API_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000/api
UPLOAD_DIR=uploads
# Use mongodb on ephemeral hosts such as Render Free.
UPLOAD_STORAGE=local
# Optional signed HTTPS relay for hosts that block SMTP. Set the same secret
# and SMTP settings on the Vercel website. Keep this secret server-side only.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# Only needed to initialize a brand-new database. Choose private values.
# Existing accounts are never reset by these variables; use the admin portal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Applied only when a new database has no admin settings yet.
INITIAL_UPI_ID=
INITIAL_BUSINESS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MAX_FILE_SIZE=5242880
PAYMENT_SCREENSHOT_RETENTION_DAYS=7
# Set to false only if you need to pause automatic cleanup in production.
ENABLE_PAYMENT_SCREENSHOT_CLEANUP=true
